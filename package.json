{
  "name": "saale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3630",
    "dev:all": "sh -c 'npx prisma generate && npx prisma db push --accept-data-loss && HOSTNAME=0.0.0.0 npm run worker:dev & HOSTNAME=0.0.0.0 npm run dev'",
    "build": "next build",
    "build:worker": "npx esbuild src/lib/queue/worker.ts --bundle --platform=node --packages=external --outfile=dist/worker.mjs --format=esm --target=node25",
    "worker:dev": "tsx --watch src/lib/queue/worker.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md}\" \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:run",
    "dup": "jscpd src/",
    "postinstall": "node scripts/fix-esm-exports.js",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "docker:prod": "docker compose up"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.7.2",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
