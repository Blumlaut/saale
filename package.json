    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "sshpk": "^1.18.0",
    "tailwind-merge": "^3.6.0",
    "telegram-markdown-v2": "^0.0.5",
    "tsdav": "^2.3.1",
    "tw-animate-css": "^1.4.0",
