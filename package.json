{
  "name": "saale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3630",
    "dev:all": "sh -c 'npx prisma generate && npx prisma db push --accept-data-loss && HOSTNAME=0.0.0.0 npm run worker:dev & HOSTNAME=0.0.0.0 npm run dev'",
    "build": "next build",
    "build:worker": "npx esbuild src/lib/queue/worker.ts --bundle --platform=node --packages=external --outdir=dist --format=cjs --target=node25",
    "worker:dev": "tsx --watch src/lib/queue/worker.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md}\" \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:run",
    "dup": "jscpd src/",
    "postinstall": "node scripts/fix-esm-exports.js",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "docker:prod": "docker compose up"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/prisma-adapter": "^1.6.17",
    "@earendil-works/pi-agent-core": "^0.79.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@earendil-works/pi-tui": "^0.79.1",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.17",
    "bullmq": "^5.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "defuddle": "^0.18.1",
    "dompurify": "^3.4.9",
    "dotenv": "^17.4.2",
    "eslint-config-next": "^16.2.9",
    "ical": "^0.8.0",
    "ical-generator": "^11.0.0",
    "imapflow": "^1.4.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "kysely": "0.29.2",
