    "react-hook-form": "^7.78.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsdav": "^2.2.2",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.2.8",
