// Saale — Database Schema
// Migration: npm run db:migrate (creates incremental migration)
// See AGENTS.md "Database Migrations" section

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth models ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  // Login handle — better-auth username plugin (lowercase, unique, nullable
  // only for rows that predate it).
  username      String?   @unique
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Admin plugin fields
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  // Two-factor plugin field
  twoFactorEnabled Boolean @default(false)
  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]
  emailAccounts    EmailAccount[]
  contacts         Contact[]
  calendarAccounts CalendarAccount[]
  queueTasks       QueueTask[]
  settings      AppSettings?
  providerApiKeys ProviderApiKey[] // user-scoped keys
  tasks              Task[]
  scriptWatchers     ScriptWatcher[]
  telegramLink       TelegramLink?
  telegramChats      TelegramChat[]
  telegramOutboundMessages TelegramOutboundMessage[]
  telegramLinkCodes  TelegramLinkCode[]
  sandboxEnvVars     SandboxEnvVar[]
  infraMachines      InfraMachine[]
  mcpServers         McpServer[]
  mcpOAuthCredentials McpOAuthCredential[]
  coderProjects      CoderProject[]
  prompts            Prompt[]
  pushSubscriptions  PushSubscription[]
  usageEvents        UsageEvent[]
  createdAt          DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  twoFactors    TwoFactor[]
  avatar        UserAvatar?

  @@map("user")
}

/// A user's profile picture, re-encoded to a 96px WebP. It lives in its own row
/// so a user list never drags the bytes along; `/api/profile/avatar` serves it.
model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String   @default("image/webp")
  size      Int
  width     Int
  height    Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatar")
}

// better-auth two-factor plugin (TOTP) — managed via the plugin, never
// write secrets/backup codes directly.
model TwoFactor {
  id                    String    @id @default(cuid())
  userId                String
  secret                String
  backupCodes           String
  verified              Boolean   @default(true)
  failedVerificationCount Int     @default(0)
  lockedUntil           DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

model Account {
  id                    String  @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String? @db.Text
  refreshToken          String? @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? @db.Text
  idToken               String? @db.Text
  password              String? @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Chat ──────────────────────────────────────────────────────

model ChatSession {
  id               String        @id @default(cuid())
  userId           String
  title            String   @db.VarChar(50)
  /// Where the title came from: "default" (no message yet), "auto" (read off
  /// the first message), "ai" (title job) or "user" (renamed or named on
  /// creation). The title job only retitles default and auto.
  titleSource      String        @default("default")
  temporary        Boolean       @default(false) // auto-deleted when user navigates away
  /// Sticks the chat to the top of the chat list, above the recency groups.
  pinned           Boolean       @default(false)
  modelProvider    String?
  modelName        String?
  thinkingLevel    String        @default("off")
  toolConfig       Json?         // { terminal: true, email: true, jobs: true, chatSearch: true, memory: true, web: true }
  messageCount     Int           @default(0)
  lastSummarizedAt DateTime?     // cursor — only process messages after this for memory extraction
  memorySummary    String?       @db.Text // compressed running summary of the conversation
  // In-progress tool state (for SSE reconnection — shows what's running when user refreshes mid-tool)
  activeToolCallId String?       @db.VarChar(100)
  activeToolName   String?       @db.VarChar(200)
  activeToolArgs   Json?
  activeToolStartedAt DateTime?
  // Sharing
  shared           Boolean       @default(false) // owner has enabled sharing
  shareToken       String?       @unique          // random 32-char token for /share/[token]
  /// Who may open the link: "public" (anyone holding it) or "account" (a signed-in viewer).
  shareAccess      String        @default("public")
  sourceShareToken String?                          // shareToken this session was copied from (idempotency guard)
  messages         ChatMessage[]
  run              ChatRun?
  scriptWatchers   ScriptWatcher[] @relation("ScriptWatcherTarget")
  /// Watchers created from this chat, whatever they report into.
  watchersFromHere ScriptWatcher[] @relation("ScriptWatcherOrigin")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  // Bumped ONLY on real chat activity (message sent/saved, title edited).
  // Sort/display timestamps in the UI use this — NOT updatedAt, which is
  // touched by tool state, background jobs (memory extraction, title
  // generation), etc. and would make every chat look "active today".
  lastActivityAt    DateTime      @default(now())
  /// Set for a coder chat: the project it works in. null is a normal chat.
  projectId        String?
  coderWorktree    CoderWorktree?
  project          CoderProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "user" | "watcher". A chat a watcher fire opened is an ordinary coder chat
  /// everywhere else; this is what lets it be badged and later cleaned up.
  origin           String        @default("user")
  /// The watcher that opened it.
  originId         String?
  /// Branch its worktree is checked out on. Null derives one from the chat id;
  /// a watcher sets it so the branch names the watcher that made it.
  worktreeBranch   String?
  /// The pull request this chat's branch is on, as `gh` last reported it. The
  /// landing page reads these instead of asking the forge for every row.
  prNumber         Int?
  /// "OPEN" | "MERGED" | "CLOSED".
  prState          String?       @db.VarChar(16)
  prDraft          Boolean?
  prUrl            String?       @db.VarChar(2048)
  /// When `gh` last answered, null for a chat nothing has asked about yet.
  prCheckedAt      DateTime?

  @@index([userId, createdAt])
  @@index([projectId, lastActivityAt])
  @@index([shareToken])
  @@index([origin, originId])
  @@map("ChatSession")
}

// ─── Coder ─────────────────────────────────────────────────────
//
// A project is a git repo inside the user's workspace; a coder chat runs in a
// checkout of one project, either a git worktree of its own or the repo itself.
// Both paths are workspace-relative, so a chat is never tied to a mount point.

model CoderProject {
  id            String   @id @default(cuid())
  userId        String
  name          String   @db.VarChar(100)
  slug          String   @db.VarChar(100)
  /// Workspace-relative repo dir, e.g. "projects/saale-web".
  repoPath      String
  originUrl     String?
  defaultBranch String   @default("main")
  /// Files every worktree gets: [{ path, content }]. Worktrees are separate
  /// checkouts, so an untracked .env in the repo never reaches them.
  envFiles      Json?
  /// Command run in a worktree once it exists, e.g. "npm install".
  setupScript   String?
  /// "worktree" gives every chat a checkout of its own; "repo" runs them all
  /// in the project's checkout.
  chatMode      String    @default("worktree")
  /// When the shared checkout last ran the setup script, null until it has.
  repoSetupAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats         ChatSession[]
  worktrees     CoderWorktree[]
  scriptWatchers ScriptWatcher[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("CoderProject")
}

/// One worktree, one coder chat. The row holds the path so cleanup can retry
/// after a directory and the registry disagree.
model CoderWorktree {
  id        String    @id @default(cuid())
  projectId String
  sessionId String    @unique
  /// Workspace-relative, e.g. "worktrees/saale-web/c-1a2b3c4d".
  path      String
  branch    String
  /// Commit the branch started from, for the ahead count.
  baseSha   String
  status    String    @default("active") // "active" | "removed"
  removedAt DateTime?
  createdAt DateTime  @default(now())
  project   CoderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session   ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("CoderWorktree")
}

model ChatMessage {
  id              String           @id @default(cuid())
  sessionId       String
  role            String // "user" | "assistant" | "system"
  content         String           @db.Text
  thinking        String?          @db.Text // thinking/reasoning content for assistant turns
  toolCalls       String?          @db.Text // JSON array of tool calls
  errorMessage    String?          @db.Text // provider error when the turn failed (stopReason "error")
  parentMessageId String?          // links turns to the root assistant message
  createdAt       DateTime         @default(now())
  editedAt        DateTime?
  /// Set while the message waits in the session's send queue (a generation
  /// was already running). Cleared when it is handed to the agent, which is
  /// also what moves it from the queue strip into the conversation.
  queuedAt        DateTime?
  /// What the turn cost and how it filled the context, see
  /// `src/lib/pi/turn-stats.ts`. Null for user turns and rows saved before it.
  stats           Json?
  session         ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments     ChatAttachment[]

  @@index([sessionId, createdAt])
  @@index([sessionId, queuedAt])
  @@map("ChatMessage")
}

/// A prompt that has not settled yet: written when a run claims its chat and
/// deleted when the run does. A row is therefore a run that never finished, and
/// the boot pass resumes it. Stopped and answered runs leave none behind.
model ChatRun {
  sessionId String      @id
  userId    String
  /// The user message the run is answering.
  messageId String
  startedAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ChatRun")
}

/// Image/file attachments linked to a chat message.
/// Stored as WebP on disk (re-encoded from original), path relative to user workspace.
model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  storageId   String      @unique // public ID for URL serving (no user leakage)
  fileName    String      // original file name
  mimeType    String      // original MIME type (e.g. "image/png")
  size        Int         // original byte size
  width       Int?
  height      Int?
  storagePath String      // path relative to user workspace (e.g. "images/abc.webp")
  createdAt   DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("ChatAttachment")
}

// ─── Memory ──────────────────────────────────────────────────────

/// Persistent memories extracted from chat history by the AI.
model Memory {
  id           String   @id @default(cuid())
  userId       String
  collection   String   // "facts" | "projects" | "people" | "preferences" | "decisions"
  title        String
  content      String   @db.Text
  tags         String[] @default([])
  source       String?  // ChatSession.id this memory came from
  accessCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, collection])
  @@index([userId, tags])
  @@map("Memory")
}

// ─── Prompts ────────────────────────────────────────────────────

/// A reusable prompt template, typed as `/name` in a chat.
model Prompt {
  id           String   @id @default(cuid())
  userId       String
  /// The `/name` the user types. Lowercase, the slash parser's charset.
  name         String   @db.VarChar(40)
  description  String   @db.VarChar(100)
  /// Shown after the name: Pi's convention, `<required>` and `[optional]`.
  argumentHint String?  @db.VarChar(100)
  /// "any" | "chat" | "coder"
  scope        String   @default("any")
  content      String   @db.Text
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("Prompt")
}

/// A prompt the instance offers every account, so a workspace's house commands
/// are written once. Instance-owned rows live in their own table: a query that
/// carries `userId` cannot reach one, so no owner check can be forgotten.
///
/// A user's own prompt of the same name hides this one (see `prompts/resolve`).
model SharedPrompt {
  id           String   @id @default(cuid())
  /// The `/name` every account types. Lowercase, the slash parser's charset.
  name         String   @unique @db.VarChar(40)
  description  String   @db.VarChar(100)
  argumentHint String?  @db.VarChar(100)
  /// "any" | "chat" | "coder"
  scope        String   @default("any")
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("shared_prompt")
}

// ─── Email ─────────────────────────────────────────────────────

model EmailAccount {
  id                 String         @id @default(cuid())
  userId             String
  email              String
  imapHost           String
  imapPort           Int
  imapSecure         Boolean        @default(true)
  smtpHost           String
  smtpPort           Int
  smtpSecure         Boolean        @default(true)
  encryptedPassword  String         @db.Text
  enabled            Boolean        @default(true)
  lastSyncedAt       DateTime?
  lastSyncError      String?        // Why the last sync attempt failed, if it did
  lastSyncErrorAt    DateTime?
  cachedFolders      Json?          // Array of folder names discovered from IMAP
  specialFolders     Json?          // { "\\Trash": "Trash", "\\Sent": "Sent", ... }
  messages           EmailMessage[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, email])
  @@map("EmailAccount")
}

model EmailMessage {
  id          String       @id @default(cuid())
  accountId   String
  uid         String // IMAP UID
  fromName    String?
  fromEmail   String
  to          String       @db.Text // JSON array
  subject     String
  date        DateTime
  bodyPreview String?     @db.Text
  bodyHtml    String?     @db.Text
  bodyText    String?     @db.Text
  isRead      Boolean     @default(false)
  isStarred   Boolean     @default(false)
  folder      String      @default("INBOX")
  tags        String[]    @default([])
  aiSummary   String?     @db.Text
  classified      Boolean     @default(false) // has the classification job processed this email?
  calendarScanned Boolean     @default(false) // has the email-to-calendar job processed this email?
  taskScanned     Boolean     @default(false) // has the task extraction job processed this email?
  spamScore     Float?
  account     EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  // IMAP UIDs are unique per mailbox, not per account — INBOX and Sent both
  // start at 1, so the folder has to be part of the key.
  @@unique([accountId, folder, uid])
  @@index([accountId, folder, isRead])
  @@index([accountId, date])
  @@map("EmailMessage")
}

// ─── Contacts ─────────────────────────────────────────────────

/// The user's contact book. Starts empty and auto-learns: sending mail to an
/// address creates or refreshes the row (see `learnContactsFromSend`).
model Contact {
  id         String    @id @default(cuid())
  userId     String
  name       String    // Display name; for auto-learned rows the email's local part
  email      String
  company    String?
  notes      String?   @db.Text
  lastSentAt DateTime? // When the user (or the agent) last sent this contact mail
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, email])
  @@index([userId, name])
  @@map("Contact")
}

// ─── Queue Tasks ───────────────────────────────────────────────

model QueueTask {
  id             String    @id @default(cuid())
  userId         String
  name           String?   // User-defined name
  type           String    // "summarization" | "classification" | "spam_filtering" | "email_sync"
  enabled        Boolean   @default(true)
  modelId        String?   // Per-job AI model selection
  config         String    @default("{}") @db.Text // JSON: cronExpression, retryPolicy, etc.
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  runs           TaskRun[]
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, type])
  @@map("QueueTask")
}

model TaskRun {
  id          String    @id @default(cuid())
  taskId      String
  status      String // "pending" | "running" | "completed" | "error"
  input       String?   @db.Text
  output      String?   @db.Text
  error       String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  task        QueueTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([taskId, status])
  @@map("TaskRun")
}

// ─── Admin Settings (singleton) ────────────────────────────────

/// Global admin configuration — one row only.
model AdminSettings {
  id                     String   @id @default("global")
  signupsEnabled         Boolean  @default(true)
  /// Shortest password the instance accepts, for sign-ups and password changes.
  minPasswordLength      Int      @default(8)
  /// Requires every account to set up two-factor sign-in before it can be used.
  requireTwoFactor       Boolean  @default(false)
  globalModelProvider    String   @default("")
  globalModelName        String   @default("")
  /// Per-provider availability, keyed by provider id:
  ///   { "anthropic": { "enabled": false } }                      — provider off
  ///   { "openai": { "enabled": true, "models": ["gpt-5"] } }     — allowlist
  ///   { "groq": { "enabled": true } }                            — no restriction
  /// An empty `models` list means the same as no list: the admin's provider
  /// switch (`enabled`) is what turns a provider off, so saving a list without
  /// touching a provider cannot switch it off by accident.
  globalProviderModels   Json?
  /// Feature switches for regular accounts that have no override of their own:
  /// { "mail": false }. Sparse — absent keys keep the built-in default.
  featureDefaults        Json?
  /// Directory scanned for global Pi plugins. Empty falls back to
  /// PI_GLOBAL_PLUGINS_DIR, then <uploads>/pi_plugins.
  piPluginsDir           String   @default("")
  /// Loads the plugins in `piPluginsDir` into every session.
  piPluginsEnabled       Boolean  @default(false)
  /// Lets plugins open dialogs in the chat (Pi's `ctx.ui`). On, a plugin that
  /// asks something waits for the answer; off, it is told "not available" at
  /// once, which is only what an admin who wants no interruptions picks.
  piPluginsUi            Boolean  @default(true)
  /// Per-plugin switches, keyed by directory name:
  ///   { "my-plugin": { "enabled": false } }
  piPluginStates         Json?
  /// Branding colours, sparse per mode:
  ///   { "light": { "primary": "#2563eb" }, "dark": { "primary": "#3b82f6" } }
  /// A token that is absent keeps the palette in globals.css.
  themeColors            Json?
  /// Name the instance shows: the wordmark, the page title, the app manifest.
  /// Empty draws the built-in name.
  workspaceName          String   @default("")
  /// File name of the uploaded agent avatar under <uploads>/branding. Empty
  /// means the built-in mark is drawn instead.
  brandingAvatar         String   @default("")
  /// The engines a web search may use, by their SearXNG name. Empty leaves every
  /// engine the search instance runs on; a populated list is the only set a
  /// search may draw from.
  webSearchEngines       String[] @default([])
  /// Categories a search without a named engine draws from.
  webSearchCategories    String[] @default(["general"])
  /// 0 off, 1 moderate, 2 strict.
  webSearchSafeSearch    Int      @default(0)
  /// SearXNG language code, `all` for every language.
  webSearchLanguage      String   @default("all")
  /// Results one search returns when the model asks for no number.
  webSearchResultsPerCall Int     @default(10)
  /// Characters a fetched page is cut to.
  webFetchMaxChars       Int      @default(50000)
  webFetchTimeoutMs      Int      @default(15000)
  webFetchMaxRedirects   Int      @default(5)
  /// Whether voice input is offered at all. VOICE_ENABLED=0 still turns it off.
  voiceEnabled           Boolean  @default(true)
  /// faster-whisper model a transcription names. Null follows VOICE_MODEL.
  voiceModel             String?
  /// Language code the server decodes as. Null follows VOICE_LANGUAGE, then the
  /// server's own detection.
  voiceLanguage          String?
  /// Decision model every account's Auto tool calls are judged by, as
  /// "provider:model". Null leaves the built-in command checks.
  approvalDecisionModel  String?
  updatedAt              DateTime @updatedAt

  @@map("admin_settings")
}

// ─── Instance mail ─────────────────────────────────────────────

/// The instance's own outgoing mail: verification links, password resets and
/// invitations leave through this relay.
///
/// One row, configured in the admin panel, so a deployment does not need a
/// `.env` edit to send a mail. The password is encrypted with lib/crypto like a
/// mail account's, and the admin API never echoes it back.
model InstanceMail {
  id      String  @id @default("global")
  enabled Boolean @default(true)
  host    String  @default("")
  port    Int     @default(587)
  /// "tls" (implicit TLS, usually 465) | "starttls" (upgrade on 587) | "none".
  security          String  @default("starttls")
  username          String  @default("")
  encryptedPassword String? @db.Text
  /// The address mail is sent from.
  fromAddress String @default("")
  /// The name shown beside that address. Empty sends the instance's own name.
  fromName        String   @default("")
  /// Admin who last saved this configuration.
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@map("instance_mail")
}

// ─── Instance single sign-on ───────────────────────────────────

/// An identity provider the login page signs people in with.
///
/// A company can have more than one directory, so this is a list: each row is a
/// provider with its own client credentials, its own callback and its own
/// allowed domains. `slug` is what names the callback and never changes; the
/// name is only what the button says.
model InstanceSso {
  id String @id @default(cuid())
  /// Names the provider and its callback (`/api/auth/callback/sso-<slug>`).
  slug    String  @unique
  enabled Boolean @default(true)
  /// The issuer URL, or its discovery document.
  issuer   String @default("")
  clientId String @default("")
  /// Encrypted with lib/crypto. Read only to build the provider.
  encryptedClientSecret String?  @db.Text
  /// The sign-in button's label.
  name                  String   @default("")
  /// Scopes a sign-in asks for. `openid` is added when it is missing.
  scopes                String[] @default(["openid", "profile", "email"])
  /// Domains a new account may come from. Empty means existing accounts only.
  allowedDomains        String[] @default([])
  /// Admin who last saved this configuration.
  updatedByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("instance_sso")
}

// ─── Roles ─────────────────────────────────────────────────────

/// A named permission bundle. `User.role` stores the name (comma-separated
/// when an account holds several), so the row is what the navs, the admin
/// routes and better-auth's own admin plugin authorize against.
///
/// The built-in roles are seeded from `src/lib/permissions/roles.ts` and may be
/// edited, but only custom roles can be renamed or deleted.
model Role {
  /// Stored on the user record, e.g. "user-manager". Immutable once created.
  name        String   @id
  label       String
  description String   @default("")
  /// { "admin": ["users"], "user": ["list"], "session": [] } — sanitized on write.
  permissions Json
  /// Seeded from code; cannot be deleted, and `admin`/`user` cannot be edited.
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Role")
}

// ─── App Settings ──────────────────────────────────────────────

model AppSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  defaultModelProvider String   @default("")
  defaultModelName     String   @default("")
  defaultThinkingLevel String   @default("default") // "default" = leave the level to Pi
  theme                String   @default("system") // "dark" | "light" | "system"
  compactActivity      Boolean  @default(true) // Collapse a turn's reasoning and tool calls into one compact line instead of a card per step
  /// Whether Telegram gets a line for every tool call. Off sends only what the agent says.
  telegramToolNotices  Boolean  @default(false)
  agentCustomInstructions String?  @db.Text // User-defined custom instructions appended to the default system prompt
  emailWritingStyle      String?  @db.Text // User-defined writing style for email reply drafts
  coderCustomInstructions String? @db.Text // Custom instructions for coder chats, in place of agentCustomInstructions
  purposeModelOverrides  Json?                  // Per-purpose model overrides: { "email_draft": { "provider": "anthropic", "model": "claude-sonnet-4-20250514" } }
  disabledModels       Json?                  // Array of "provider:modelId" strings for models the user has disabled
  defaultToolConfig    Json?                  // Default tool config for new chat sessions: { "files": true, "email": true, ... }
  coderToolConfig      Json?                  // Default tool config for new coder chats, sparse against CODER_TOOL_DEFAULTS
  toolPolicies         Json?                  // Per-tool approval policies: { "bash": "ask", "mail_send": "off", ... }
  toolExposure         Json?                  // Per-category how tools reach the model: { "email": "codemode", "jobs": "deferred" }. Sparse — absent = "direct".
  /// Decision model that judges the tool calls Auto would run on its own, as
  /// "provider:model". Null follows `AdminSettings.approvalDecisionModel`.
  approvalDecisionModel String?
  sidebarItems         Json?                  // Sidebar layout, in display order: [{ "id": "chat", "hidden": false }, ...]. null = default order, everything visible
  /// This account's feature switches (sparse): { "mail": false }. Absent keys
  /// follow the instance defaults.
  features              Json?
  /// Which push notifications are wanted (sparse): { "chatDone": false }.
  /// Absent keys follow the defaults in `src/lib/notifications/preferences.ts`.
  pushNotifications     Json?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt            DateTime @updatedAt

  @@map("AppSettings")
}

// ─── Web Push ──────────────────────────────────────────────────

/// One browser's Web Push endpoint. A user has one row per device, and one per
/// browser profile on that device: a subscription belongs to the browser that
/// created it, so a laptop and a phone store two rows.
///
/// `endpoint` is the push service's URL and `p256dh`/`auth` are the browser's
/// keys, which together are what a payload is encrypted for. A push service
/// answers 404/410 once a subscription is gone, which is what prunes the row.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// unique across users. one browser is subscribed for one account at a time.
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Browser label, so a user can tell their devices apart.
  userAgent String?
  /// "desktop" or "mobile". A computer hears about a notification at once, a
  /// phone waits until no computer has shown it.
  deviceKind String  @default("desktop")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("PushSubscription")
}

// ─── Provider API Keys ─────────────────────────────────────────

/// API keys for model providers. null userId = global (admin-managed), non-null = user-scoped.
model ProviderApiKey {
  id             String   @id @default(cuid())
  userId         String?  // null = global provider, non-null = user-specific
  provider       String   // "anthropic" | "openai" | "google" | "custom" | ...
  encryptedKey   String   @db.Text
  /// Encrypted Pi credential — `ApiKeyCredential` ({ key, env }) or
  /// `OAuthCredential` (tokens) — for a provider whose auth flow Pi owns.
  /// `encryptedKey` holds the key of an OpenAI-compatible endpoint only.
  encryptedCredential String? @db.Text
  label          String   @default("") // optional label
  baseUrl        String?  // for custom OpenAI-compatible providers
  /// Output token cap for every model this endpoint serves: a model that sets
  /// its own in `modelCapabilities` overrides it, null = Pi's model default.
  maxOutputTokens Int?
  /// Context window for every model this endpoint serves: a model that sets
  /// its own in `modelCapabilities` overrides it, null = Pi's model default.
  contextWindow   Int?
  /// Per-model settings (detected, or set by the user) for a provider whose
  /// models Saale discovers from `/models`: { "<modelId>": { "vision": true,
  /// "contextWindow": 32768, "maxOutputTokens": 8192 } }. A field a model leaves
  /// out inherits the row's default, then Pi's catalog, then Pi.
  modelCapabilities Json?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@map("provider_api_key")
}

// ─── Calendar ──────────────────────────────────────────────────

model CalendarAccount {
  id                   String     @id @default(cuid())
  userId               String
  name                 String     // User-friendly label (e.g. "Google Work", "iCloud Personal", "Local")
  accountType          String     @default("caldav") // "caldav" | "local"
  // CalDAV fields (nullable for local accounts)
  serverUrl            String?    // e.g. "https://caldav.icloud.com"
  username             String?    @default("")
  encryptedPassword    String?    @db.Text // App password or token secret
  authMethod           String     @default("basic") // "basic" | "oauth" | "bearer"
  // OAuth fields (nullable, used when authMethod = "oauth")
  tokenUrl             String?
  clientId             String?
  refreshToken         String?    @db.Text
  accessToken          String?    @db.Text
  accessTokenExpiresAt DateTime?
  enabled              Boolean    @default(true)
  lastSyncedAt         DateTime?
  calendars            Calendar[]
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId, accountType])
  @@index([userId])
  @@map("CalendarAccount")
}

model Calendar {
  id               String         @id @default(cuid())
  accountId        String
  remoteId         String?        // Remote calendar identifier (URL or ID from CalDAV server)
  name             String         // Display name from server
  color            String?        // Calendar color (hex, from server or user override)
  description      String?        @db.Text
  readOnly         Boolean        @default(false)
  enabled          Boolean        @default(true)
  lastSyncedAt     DateTime?
  ctag             String?        // Calendar CTAG for sync detection
  syncToken        String?        // Sync-token for incremental sync (RFC 6638)
  events           CalendarEvent[]
  subscriptions    CalendarSubscription[]
  account          CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([accountId, remoteId])
  @@index([accountId])
  @@map("Calendar")
}

model CalendarEvent {
  id               String     @id @default(cuid())
  calendarId       String
  uid              String     // iCalendar UID (unique across calendars)
  summary          String     @default("(no title)")
  description      String?    @db.Text
  location         String?
  url              String?
  status           String?    // "CONFIRMED" | "TENTATIVE" | "CANCELLED"
  transparency     String?    // "OPAQUE" | "TRANSPARENT" (free/busy)
  sequence         Int        @default(0) // iCalendar SEQUENCE for conflict detection

  // Dates
  dtStart          DateTime   // Start datetime (or all-day date)
  dtEnd            DateTime?  // End datetime (null for all-day, computed from duration)
  allDay           Boolean    @default(false)
  timeZone         String?    // Timezone identifier (e.g. "Europe/Berlin")

  // Recurrence
  recurrenceRule   String?    @db.Text // RRULE string
  recurrenceDateIds String[]  @default([]) // RDATE UIDs for expanded instances
  exceptionDateIds String[]   @default([]) // EXDATE UIDs

  // Alerts
  alerts           String?    @db.Text // JSON array of { triggerMinutes, action }
  /// When this event's reminder was pushed, so the sweep sends it once.
  remindedAt       DateTime?

  // Origin tracking
  source           String     @default("manual") // "manual" | "caldav" | "email_extraction" | "ics_import"
  sourceEmailId    String?    // Link back to EmailMessage if created by email extraction

  // Sync metadata
  etag             String?    // Entity tag for change detection
  lastModified     DateTime?

  calendar         Calendar   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([calendarId, uid])
  @@index([calendarId, dtStart])
  @@index([dtStart])
  @@map("CalendarEvent")
}

// Remote ICS URL subscriptions (read-only feeds synced into local calendars)
model CalendarSubscription {
  id           String   @id @default(cuid())
  userId       String
  calendarId   String
  name         String   // Display name for the subscription
  url          String   // Remote ICS URL
  username     String?  // Optional auth
  password     String?  @db.Text // Optional auth
  etag         String?  // Last ETag for conditional fetch
  enabled      Boolean  @default(true)
  lastSyncedAt DateTime?
  calendar     Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([calendarId, url])
  @@index([userId])
  @@map("CalendarSubscription")
}

// ─── Tasks ─────────────────────────────────────────────────────

/// Actionable items — between a shopping list and a calendar event.
model Task {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?   @db.Text
  status        String    @default("pending") // "pending" | "completed"
  priority      String    @default("medium")  // "low" | "medium" | "high"
  dueDate       DateTime? // Date-only — stored at midnight UTC
  tags          String[]  @default([])
  order         Int       @default(0)          // Manual sort within groups
  source        String    @default("manual")  // "manual" | "chat" | "email_extraction"
  sourceEmailId String?   // EmailMessage.id — no FK (cross-model traceability)
  completedAt   DateTime?
  notifiedAt    DateTime? // Last time a due-date notification was sent
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
  @@index([userId, status, priority])
  @@map("Task")
}

// ─── Script Watchers ──────────────────────────────────────────

/// A scripted watcher: runs a codemode script on a schedule and wakes the
/// agent only when the script reports something worth reporting.
///
/// The tick costs one QuickJS sandbox and no model call, so a watcher can poll
/// far more often than an agent job could afford to run. The model is prompted
/// only when the script returns a value (see `lib/watchers/wake.ts`).
model ScriptWatcher {
  id          String  @id @default(cuid())
  userId      String
  name        String  @db.VarChar(100)
  description String? @db.Text

  /// Script body, run in the codemode sandbox as an async function body. Empty
  /// means the automation fires on every tick: a schedule with no gate.
  script     String?  @db.Text

  /// Null means the automation has no schedule: it runs only when started by hand.
  cronExpression String?
  enabled        Boolean @default(true)

  /// "chat" | "silent" | "coder": where a fire goes.
  deliver        String  @default("chat")
  /// The conversation a `chat` fire is posted into, and the context its script
  /// runs in. Only a `chat` watcher has one, so only it goes with the chat.
  sessionId      String?
  /// The conversation this watcher was created from. A chat-aware tool its
  /// script calls acts as this chat, so a message the script sends belongs to
  /// the thread that asked for the watcher. Survives that chat's deletion.
  originSessionId String?
  /// The project a `coder` fire dispatches into.
  projectId      String?
  /// "per-fire" | "sticky": a fresh worktree for every fire, or one the watcher
  /// keeps for a thread that runs across fires.
  worktreeMode   String  @default("per-fire")
  /// How long a finished per-fire chat is kept, in minutes.
  retentionMinutes Int   @default(1440)
  /// The chat a sticky watcher keeps its work in.
  stickySessionId String?
  /// Instructions handed to the agent when the watcher fires; the script's
  /// returned value is appended as JSON.
  wakePrompt     String  @db.Text
  /// Model for a standalone wake. A chat-bound wake is a turn in that
  /// conversation, so the conversation's own model governs instead.
  modelId        String?
  /// Thinking level for a standalone wake, as the model picker stores it.
  thinkingLevel  String  @default("off")

  /// The script's `store()`, carried from one tick to the next.
  store Json @default("{}")

  lastValue       String?   @db.Text
  lastTickAt      DateTime?
  lastError       String?   @db.Text
  lastFiredAt     DateTime?
  tickCount       Int       @default(0)
  fireCount       Int       @default(0)
  /// Minimum gap between wakes, in minutes. A fire inside the window is
  /// recorded as `cooldown` and not delivered — a bound the definition owns,
  /// so a script cannot spend the user's tokens at will.
  cooldownMinutes Int       @default(0)
  /// Fires delivered before the automation stops itself. Null runs for as long as
  /// its cron does; raising or clearing the limit restarts a finished one.
  maxFires        Int?

  ticks     ScriptWatcherTick[]
  session   ChatSession?       @relation("ScriptWatcherTarget", fields: [sessionId], references: [id], onDelete: Cascade)
  originSession ChatSession?   @relation("ScriptWatcherOrigin", fields: [originSessionId], references: [id], onDelete: SetNull)
  project   CoderProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, name])
  @@index([userId, enabled])
  @@index([sessionId])
  @@index([originSessionId])
  @@index([projectId])
  @@map("ScriptWatcher")
}

/// One tick of a watcher, kept for diagnosis: a predicate that never matches
/// looks exactly like nothing happening, so the recent ticks are what makes a
/// broken script visible. Old rows are pruned (see `TICK_HISTORY_LIMIT`).
model ScriptWatcherTick {
  id        String @id @default(cuid())
  watcherId String
  /// "idle" | "fired" | "reported" | "cooldown" | "blocked" | "error"
  status    String
  /// The script's returned value, JSON-encoded.
  value     String? @db.Text
  error     String? @db.Text
  /// The script's `text()`/`console` output.
  output    String? @db.Text
  durationMs Int     @default(0)
  callCount  Int     @default(0)
  /// The tools the script called, so a tick says what delivered it.
  toolNames  String[] @default([])
  /// The chat this tick's fire was delivered into.
  sessionId  String?
  /// What the woken agent answered, for a fire with no chat to answer in.
  answer     String? @db.Text
  /// Tokens the wake spent. Zero for a tick that woke nobody.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)

  watcher   ScriptWatcher @relation(fields: [watcherId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([watcherId, createdAt])
  @@map("ScriptWatcherTick")
}

// ─── Telegram Integration ──────────────────────────────────────

/// The Telegram bot this Saale instance runs — a single row, configured by an
/// admin. Users link their own Telegram account to it instead of each running
/// their own bot. Token is encrypted at rest (AES-256-GCM via lib/crypto) and
/// is never returned by an API route.
model TelegramBot {
  id              String         @id @default("global")
  encryptedToken  String         @db.Text // encrypted bot token
  enabled         Boolean        @default(true)
  botId           BigInt?        // numeric bot ID from getMe
  botUsername     String?        // @username (without @)
  webhookSecret   String         // random secret for webhook verification
  /// Admin who last saved this configuration (audit trail).
  updatedByUserId String?
  links           TelegramLink[]
  chats           TelegramChat[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("TelegramBot")
}

/// A Saale user's linked Telegram account.
///
/// One Telegram identity per Saale user, and one Saale user per Telegram
/// identity: `telegramUserId` is globally unique, so an incoming message can
/// only ever resolve to the single user who linked that identity — nothing in
/// the message itself can pick a different account.
///
/// A private chat's ID equals its user's ID; `telegramChatId` is stored
/// explicitly because that is the value messages are sent to.
model TelegramLink {
  id             String      @id @default(cuid())
  botId          String
  userId         String      @unique
  telegramUserId BigInt      @unique
  telegramChatId BigInt
  displayName    String?
  /// The chat this Telegram conversation is in. Set by a routed message and by
  /// `/new`, so a message that answers nothing continues the same conversation.
  activeSessionId String?
  bot            TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([botId])
  @@index([activeSessionId])
  @@map("TelegramLink")
}

/// One message Saale sent into Telegram, so a reply can find the chat that
/// produced it.
///
/// A reply is matched on `messageId`, which Telegram guarantees is unique within
/// a chat. A long message is split into several Telegram messages, so one
/// delivery leaves several rows, all naming the same source session. Rows are
/// pruned on a TTL; `TelegramLink.lastOutboundSessionId` covers the case where
/// the user replies without quoting anything.
model TelegramOutboundMessage {
  id        String   @id @default(cuid())
  userId    String
  botId     String
  chatId    BigInt
  messageId BigInt
  /// The chat that produced the message. Null when the delivery had no source
  /// chat, such as a task reminder or an agent job run.
  sessionId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("TelegramOutboundMessage")
}

/// A Telegram group the bot may post into. One owner per group.
///
/// Membership is the permission: the bot is in a group because a linked user
/// added it, so `ownerUserId` is who that was. `chatId` is unique, which is what
/// makes a refused re-add enforceable and keeps ownership from moving.
model TelegramChat {
  id          String      @id @default(cuid())
  botId       String
  ownerUserId String
  chatId      BigInt      @unique
  title       String?
  /// "group" | "supergroup"
  kind        String
  memberCount Int?
  /// False once the bot was removed from the group, so the UI shows it is gone.
  enabled     Boolean     @default(true)
  /// Last successful getChat, which drives the lazy title refresh.
  syncedAt    DateTime?
  bot         TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  owner       User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerUserId])
  @@map("TelegramChat")
}

/// Short-lived single-use code that binds a Telegram identity to the Saale
/// user who requested it.
///
/// Only the hash is stored — the plaintext exists solely in the deep link
/// rendered inside that user's authenticated session, so possessing the code
/// is proof of having been signed in as that user.
model TelegramLinkCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("TelegramLinkCode")
}

/// GitHub integration — stores a user's GitHub personal access token.
/// A variable handed to the identity's commands (GH_TOKEN, ...).
///
/// Encrypted at rest, unique per user+name. Values never reach a model, a
/// prompt, a log line or a transcript. only names do.
model SandboxEnvVar {
  id             String   @id @default(cuid())
  userId         String
  name           String   @db.VarChar(64)
  encryptedValue String   @db.Text
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("SandboxEnvVar")
}

// ─── Infrastructure Management ─────────────────────────────────

/// Remote machines the agent can SSH into and manage.
model InfraMachine {
  id            String       @id @default(cuid())
  userId        String
  name          String       @db.VarChar(100) // User-friendly label
  host          String       // hostname or IP
  port          Int          @default(22)
  username      String
  authMethod    String       @default("key") // "key" | "password"
  encryptedKey  String?      @db.Text         // SSH private key (PEM)
  encryptedPass String?      @db.Text         // Password (if authMethod="password")
  passPhrase    String?      @db.Text         // Key passphrase (encrypted)
  notes         InfraNote[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("InfraMachine")
}

// ─── MCP Servers ───────────────────────────────────────────────

/// Model Context Protocol servers the agent connects to for this user.
/// Only streamable HTTP endpoints are stored — see src/lib/mcp/servers.ts.
model McpServer {
  id             String   @id @default(cuid())
  userId         String
  /// Server name; names the tools it contributes (`mcp__<name>__<tool>`).
  name           String   @db.VarChar(64)
  /// Streamable HTTP endpoint, e.g. https://homeassistant.local:8123/api/mcp
  url            String   @db.Text
  /// One-line summary of what the server offers, shown to the model.
  description    String   @default("")
  /// Bearer token sent as the Authorization header (AES-256-GCM via lib/crypto).
  encryptedToken String?  @db.Text
  /// How this server's tool calls are approved: "ask" | "allow" | "off".
  toolPolicy     String   @default("ask")
  enabled        Boolean  @default(true)
  /// Whether the server connects in a chat. Its own switch, so one server can be
  /// chat-only while another is coder-only.
  chatEnabled    Boolean  @default(true)
  /// Whether the server connects in a coder chat.
  coderEnabled   Boolean  @default(true)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthCredential McpOAuthCredential?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("McpServer")
}

/// An MCP server the instance offers every account. Same shape as `McpServer`
/// without an owner, and its own table for the same reason as `SharedPrompt`:
/// an owner-scoped query cannot reach a shared row.
///
/// A shared server authenticates with a stored bearer token. OAuth sign-in is
/// per account, so it stays on the user's own servers.
model SharedMcpServer {
  id             String   @id @default(cuid())
  /// Server name; names the tools it contributes (`mcp__<name>__<tool>`).
  name           String   @unique @db.VarChar(64)
  /// Streamable HTTP endpoint, e.g. https://homeassistant.local:8123/api/mcp
  url            String   @db.Text
  /// One-line summary of what the server offers, shown to the model.
  description    String   @default("")
  /// Bearer token sent as the Authorization header (AES-256-GCM via lib/crypto).
  encryptedToken String?  @db.Text
  /// How this server's tool calls are approved: "ask" | "allow" | "off".
  toolPolicy     String   @default("ask")
  enabled        Boolean  @default(true)
  chatEnabled    Boolean  @default(true)
  coderEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shared_mcp_server")
}

/// OAuth credentials for one MCP server: Pi's client registration, tokens and
/// in-flight PKCE state, as one encrypted JSON blob (AES-256-GCM via lib/crypto).
/// A URL change discards the state — Pi ignores state for another server URL.
model McpOAuthCredential {
  serverId       String    @id
  userId         String
  /// Server URL the stored state belongs to, for detecting a reused endpoint.
  serverUrl      String    @db.Text
  /// AES-256-GCM encrypted JSON of Pi's `McpOAuthState`.
  encryptedState String    @db.Text
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  server         McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@map("McpOAuthCredential")
}

/// Agent-maintained notes about a machine.
model InfraNote {
  id        String       @id @default(cuid())
  machineId String
  title     String       @db.VarChar(200)
  content   String       @db.Text
  category  String       @default("general") // "general" | "services" | "paths" | "credentials" | "quirks" | "config"
  machine   InfraMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([machineId, category])
  @@map("InfraNote")
}

// ─── Usage ledger ──────────────────────────────────────────────

/// One model call's bill. Append-only: the admin usage page adds these up per
/// account, and `scope` is what splits our provider keys from a user's own.
/// `ChatMessage.stats` carries the same numbers for the per-turn card; this row
/// is the one place that covers chat, jobs, automations and drafts.
model UsageEvent {
  id     String @id @default(cuid())
  userId String
  /// What ran the call: "chat" | "coder" | "job" | "automation" | "email_draft".
  kind     String @db.VarChar(20)
  provider String @db.VarChar(100)
  model    String @db.VarChar(200)
  /// "global" (a workspace key, we pay) | "own" (the user's own key).
  scope        String @db.VarChar(10)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  cacheRead    Int    @default(0)
  cacheWrite   Int    @default(0)
  /// USD, as the provider billed it or the catalog estimated it.
  cost Float @default(0)
  /// True when the provider reported the amount rather than a catalog estimate.
  billed Boolean @default(false)
  /// The chat, job run or watcher the call belongs to.
  refId     String?  @db.VarChar(40)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("UsageEvent")
}
