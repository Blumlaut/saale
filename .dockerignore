# Dependencies & build output — never copy host artifacts into the image
node_modules
.next
dist
coverage
playwright-report
test-results

# VCS
.git
.gitignore

# Local env & secrets
.env
.env.*
!.env.example

# Tests, docs and host tooling not needed at build time. `e2e/env.ts` is the
# one test file the build reads: the playwright config and scripts/shot.ts
# import it, and the type check covers every file tsconfig includes.
__tests__
e2e/**
!e2e/env.ts
.github
.pi
docs
searxng
AGENTS.md
DESIGN.md
README.md
docker-compose*.yml

# Prisma client is generated into node_modules/.prisma, never from here
prisma/generated

# Logs & misc
*.log
*.tsbuildinfo
.DS_Store
uploads
