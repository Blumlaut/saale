# Database (PostgreSQL 17)
# When running via docker compose, use the service name "postgres" as host.
DATABASE_URL="postgresql://saale:saale@saale-postgres:5432/saale"

# Redis 8
REDIS_URL="redis://saale-redis:6379"

# Better Auth — session encryption secret (any random string, 32+ chars)
BETTER_AUTH_SECRET="change-me-in-production"

# Better Auth — public base URL of the app
# Also the base for OAuth redirect URIs (MCP sign-ins, Telegram login) and the
# Telegram webhook. The one place the app's public URL is configured.
BETTER_AUTH_URL="http://localhost:3630"

# Telegram login (optional) — sign in with the instance's Telegram bot.
# In @BotFather open the bot's Login Widget and add this app's origin plus
# <BETTER_AUTH_URL>/api/auth/callback/telegram-oidc as allowed URLs; the same
# screen shows the Client ID (the bot's own numeric id) and Client Secret.
# Both must be set for the sign-in button to appear.
# TELEGRAM_OIDC_CLIENT_ID="123456789"
# TELEGRAM_OIDC_CLIENT_SECRET="change-me"

# AES-256-GCM key for encrypting email passwords at rest.
# Must be a 64-character hex string (32 bytes / 256 bits).
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Web Push — VAPID key pair that identifies this instance to the browsers' push
# services (Chrome, Firefox, Safari) and signs the payloads. Generate a pair with:
#   npx web-push generate-vapid-keys
# Rotating them invalidates every subscription: each user has to enable
# notifications again. Leave unset to keep push notifications off.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Contact address the push service can use to reach the operator (mailto: or
# https: URI). Defaults to mailto:noreply@<host of BETTER_AUTH_URL>.
# VAPID_SUBJECT="mailto:you@example.com"

# Path for user file storage (optional, defaults to ./uploads)
# UPLOADS_DIR="./uploads"

# SearXNG instance URL (used by web_search and web_fetch tools).
# When running via docker compose, use the service name "searxng" as host.
SEARXNG_URL="http://saale-searxng:8080"

# Arctic Shift archive API — Reddit data source for the web_fetch tool.
# Reddit blocks direct server fetches, so reddit.com URLs are resolved here.
ARCTIC_SHIFT_URL="https://arctic-shift.photon-reddit.com"

# Sandbox — the service that runs agents' commands in per-workspace containers.
# When running via docker compose, use the service name "sandbox-exec" as host.
# Leave unset to run without bash tools; files still work from the volume.
SANDBOX_URL="http://saale-sandbox-exec:8100"

# Sandbox — bearer key for the service (shared with the container).
# Generate one with: openssl rand -hex 32
SANDBOX_API_KEY="change-me-in-production"

# Sandbox — where the workspaces volume is mounted. The same path inside a
# tenant container, so a file path means the same thing on both sides.
# SANDBOX_WORKSPACES_DIR="/workspaces"

# Sandbox — Docker volume holding one directory per user and council. Compose
# creates it on the first deploy.
# SANDBOX_VOLUME="saale_workspaces"

# Sandbox — the account commands run as. "root" lets an agent apt-get install
# packages inside its container; "agent" is the tighter setting (no installs).
# SANDBOX_USER="root"
# SANDBOX_UID=1000
# SANDBOX_GID=1000

# Previews — the domains a dev server in a workspace is served on. Saale derives
# it from BETTER_AUTH_URL ("https://preview.<its host>"), so set this only when
# the wildcard lives somewhere else. Leave it unset to keep previews off.
# The wildcard must point at this host and have its own certificate:
#   *.preview.example.com  →  the same server
# PREVIEW_DOMAIN="preview.example.com"

# Sandbox — port the preview listener binds inside the sandbox service. This is
# not the public port: nginx forwards the wildcard vhost to it. 0 turns the
# listener off.
# SANDBOX_PREVIEW_PORT=8101

# Sandbox — per-container limits and lifetime.
# SANDBOX_MEMORY="4g"
# SANDBOX_PIDS=512
# SANDBOX_CPUS=2
# SANDBOX_IDLE_MINUTES=240
# Days before a container is removed, taking its apt/npm/global-pip installs
# with it. 0 keeps containers forever; user-level installs in $HOME survive
# either way.
# SANDBOX_CONTAINER_TTL_DAYS=7
# Hours before a scratch file under a workspace's .tmp/ is removed. 0 keeps them.
# SANDBOX_TMP_HOURS=72
# Max size (bytes) for one file transfer between a machine and the workspace
# (infra_download_file / infra_upload_file). Default: 52428800 (50MB).
# INFRA_TRANSFER_MAX_BYTES=52428800
WORKER_API_KEY=change-me-to-a-random-string

# Council — parallel agent rooms. Admin-only, and hidden in the sidebar until
# enabled there. Set to 0 to remove the module entirely (nav, routes and tools).
COUNCIL_ENABLED=1
