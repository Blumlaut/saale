# Database (PostgreSQL 17)
# When running via docker compose, use the service name "postgres" as host.
DATABASE_URL="postgresql://saale:saale@postgres:5432/saale"

# Redis 8
REDIS_URL="redis://redis:6379"

# Better Auth — session encryption secret (any random string, 32+ chars)
BETTER_AUTH_SECRET="change-me-in-production"

# Better Auth — public base URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# AES-256-GCM key for encrypting email passwords at rest.
# Must be a 64-character hex string (32 bytes / 256 bits).
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Path for user file storage (optional, defaults to ./uploads)
# UPLOADS_DIR="./uploads"

# SearXNG instance URL (used by web_search and web_fetch tools).
# When running via docker compose, use the service name "searxng" as host.
SEARXNG_URL="http://saale-searxng:8080"

# Open Terminal — sandboxed execution environment for bash and file tools.
# When running via docker compose, use the service name "open-terminal" as host.
OPEN_TERMINAL_URL="http://saale-open-terminal:8000"

# Open Terminal — API key for authentication (shared with the container).
# Generate one with: openssl rand -hex 32
OPEN_TERMINAL_API_KEY="change-me-in-production"
WORKER_API_KEY=change-me-to-a-random-string
